theme = Catppuccin Mocha

shell-integration-features = no-cursor
cursor-style-blink = false
cursor-style = block

term = xterm-256color
clipboard-read = allow
clipboard-write = allow

font-family = CaskaydiaCove Nerd Font
font-size = 12

resize-overlay = never

background-opacity = 0.9
window-padding-x = 14
window-padding-y = 14
window-decoration = none

confirm-close-surface = false
quit-after-last-window-closed = false

clipboard-paste-protection = false

keybind = shift+insert=paste_from_clipboard
keybind = ctrl+insert=copy_to_clipboard

keybind = ctrl+shift+e=ignore
keybind = ctrl+shift+o=ignore
keybind = ctrl+alt+arrow_down=ignore
keybind = ctrl+alt+arrow_up=ignore
keybind = ctrl+alt+arrow_left=ignore
keybind = ctrl+alt+arrow_right=ignore
keybind = ctrl+shift+enter=ignore
keybind = super+ctrl+shift+arrow_down=ignore
keybind = super+ctrl+shift+arrow_up=ignore
keybind = super+ctrl+shift+arrow_left=ignore
keybind = super+ctrl+shift+arrow_right=ignore
keybind = super+ctrl+[=ignore
keybind = super+ctrl+]=ignore


