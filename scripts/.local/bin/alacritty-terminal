#!/usr/bin/env bash

set -euo pipefail

if ! pgrep -x alacritty >/dev/null 2>&1; then
    nohup alacritty --daemon >/dev/null 2>&1 &
    sleep 0.2
fi

if [[ "${1:-}" == "msg create-window" ]]; then
    shift

    if (($#)); then
        exec alacritty -e "$@"
    else
        exec alacritty
    fi
fi

exec alacritty "$@"
