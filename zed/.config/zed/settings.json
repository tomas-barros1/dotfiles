// Zed Settings
//
// Documentação: https://zed.dev/docs/configuring-zed
// Para visualizar as configurações padrão: cmd+shift+p / ctrl+shift+p → "zed: open default settings"

{
  // Aparência geral
  // "cli_default_open_behavior": "existing_window",
  "disable_ai": false,
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "colorize_brackets": true,
  "project_panel": {
    "dock": "right",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "toolbar": {
    "breadcrumbs": false,
    "agent_review": false,
    "selections_menu": false,
    "quick_actions": false,
  },
  "show_signature_help_after_edits": true,
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "theme": {
    "mode": "system",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_features": {
    "calt": true,
  },

  // Modo Vim
  "vim_mode": true,

  // Salvamento automático
  "autosave": {
    "after_delay": {
      "milliseconds": 100,
    },
  },

  // Formatação
  "format_on_save": "on",

  "terminal": {
    "shell": {
      "program": "codemux",
    },
    "font_family": "JetBrainsMono Nerd Font",
  },

  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": null,
    },
  },

  "agent": {
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-6.1-sol",
      "enable_thinking": true,
      "effort": "medium"
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "always_confirm": [
            {
              "pattern": "\\bsudo\\b",
            },
            {
              "pattern": "\\bgit\\s+push\\b",
            },
          ],
        },
      },
    },
  },
  "context_servers": {
    "ai-memory": {
      "url": "http://127.0.0.1:49374/mcp"
    }
  },
}
