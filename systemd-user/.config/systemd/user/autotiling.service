[Unit]
Description=Autotiling (Sway)
PartOf=graphical-session.target
After=graphical-session.target
# SWAYSOCK só é exportado pelo uwsm finalize em sessões Sway
ConditionEnvironment=SWAYSOCK

[Service]
ExecStart=/usr/bin/autotiling
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
