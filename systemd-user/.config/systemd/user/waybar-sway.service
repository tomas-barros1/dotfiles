[Unit]
Description=Waybar (Sway config)
PartOf=graphical-session.target
After=graphical-session.target
# SWAYSOCK só é exportado pelo uwsm finalize em sessões Sway
ConditionEnvironment=SWAYSOCK

[Service]
ExecStart=/usr/bin/waybar --config %h/dotfiles/waybar-sway/.config/waybar/config.jsonc --style %h/dotfiles/waybar-sway/.config/waybar/style.css
ExecReload=kill -SIGUSR2 $MAINPID
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
