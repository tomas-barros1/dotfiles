[Unit]
Description=Sway config auto-reload watcher (inotifywait)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=SWAYSOCK

[Service]
# Pula limpo se inotify-tools não estiver instalado
ExecCondition=/usr/bin/sh -c "command -v inotifywait"
ExecStart=/bin/sh -c "while inotifywait -qq -e close_write -r %h/.config/sway/; do swaymsg reload; done"
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
