{
  // Waybar — Catppuccin Mocha (redesign v2)
  // =====================================
  "layer": "top",
  "position": "top",
  "height": 40,
  "spacing": 0,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "group/tray-wrap",
    "group/system",
    "clock"
  ],
  // Workspaces
  "hyprland/workspaces": {
    "format": "{name}",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "all-outputs": false,
    "active-only": false,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  // Janela ativa
  "hyprland/window": {
    "format": "{}",
    "max-length": 60,
    "separate-outputs": true,
    "icon": true,
    "icon-size": 16
  },
  // Bandeja — isolada em sua própria cápsula
  "group/tray-wrap": {
    "orientation": "horizontal",
    "modules": [
      "tray"
    ]
  },
  "tray": {
    "spacing": 24,
    "icon-size": 15
  },
  // Sistema — volume, brilho, rede e clima juntos numa única cápsula
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "custom/brightness",
      "network",
      "custom/weather"
    ]
  },
  // Volume
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂯 {volume}%",
    "format-bluetooth-muted": "󰂲 mudo",
    "format-muted": "󰖁 mudo",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "tooltip-format": "{desc}\nVolume: {volume}%"
  },
  // Brilho (DDC/CI)
  "custom/brightness": {
    "exec": "v=$(ddcutil -b 7 getvcp 10 -t --sleep-multiplier 0 2>/dev/null | awk '{print $4}'); [[ \"$v\" =~ ^[0-9]+$ ]] && printf '{\"text\": \"%s%%\"}' \"$v\" || printf '{\"text\": \"N/A\"}'",
    "format": "󰃟 {}",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "v=$(walker --dmenu -p 'Brilho (0-100):'); [[ \"$v\" =~ ^[0-9]+$ ]] && (( v>=0 && v<=100 )) && ddcutil -b 7 setvcp 10 -- \"$v\" 2>/dev/null; pkill -RTMIN+8 waybar",
    "on-scroll-up": "c=$(ddcutil -b 7 getvcp 10 -t --sleep-multiplier 0 2>/dev/null | awk '{print $4}'); [[ \"$c\" =~ ^[0-9]+$ ]] && n=$((c+10)) && (( n>100 && (n=100) )); ddcutil -b 7 setvcp 10 -- \"${n:-100}\" 2>/dev/null; pkill -RTMIN+8 waybar",
    "on-scroll-down": "c=$(ddcutil -b 7 getvcp 10 -t --sleep-multiplier 0 2>/dev/null | awk '{print $4}'); [[ \"$c\" =~ ^[0-9]+$ ]] && n=$((c-10)) && (( n<0 && (n=0) )); ddcutil -b 7 setvcp 10 -- \"${n:-0}\" 2>/dev/null; pkill -RTMIN+8 waybar",
    "tooltip": false
  },
  // Rede
  "network": {
    "interval": 3,
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰖪 desconectado",
    "on-click": "uwsm app -- xdg-terminal-exec impala",
    "tooltip-format-wifi": " {essid}\n{ipaddr}/{cidr}\nSinal: {signalStrength}%\nFrequência: {frequency}MHz",
    "tooltip-format-ethernet": "󰈀 {ifname}\n{ipaddr}/{cidr}\n↑ {bandwidthUpBytes} ↓ {bandwidthDownBytes}",
    "tooltip-format-disconnected": "sem conexão"
  },
  // Clima
  "custom/weather": {
    "exec": "waybar-weather",
    "on-click": "mousam",
    "restart-interval": 60,
    "return-type": "json",
    "hide-empty-text": true
  },
  // Relógio — módulo em destaque (accent) da barra
  "clock": {
    "interval": 1,
    "format": " {:L%A %d %H:%M}",
    "format-alt": " {:L%A, %d de %B de %Y}",
    "tooltip-format": "<big>{:L%d de %B de %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "locale": "pt_BR.utf8",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#f5e0dc'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weeks": "<span color='#94e2d5'><b>S{}</b></span>",
        "weekdays": "<span color='#fab387'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  }
}
